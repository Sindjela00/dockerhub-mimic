@backend_HostAddress = http://localhost:5050
@adminEmail = admin@dockerhubmimic.local
@adminPassword = Welcome1
@demoEmail = demo@dockerhubmimic.local
@demoPassword = Password1

# ============ AUTH ENDPOINTS ============

### Register a new user
POST {{backend_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "testuser@example.com",
  "password": "TestPassword123"
}

### Login as admin
# @name admin_login
POST {{backend_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "{{adminPassword}}"
}

### Login as demo user
# @name demo_login
POST {{backend_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "identifier": "demo",
  "password": "{{demoPassword}}"
}

### Change password
POST {{backend_HostAddress}}/api/auth/change_password
Content-Type: application/json
Authorization: Bearer {{admin_login.response.body.token}}

{
  "oldPassword": "{{adminPassword}}",
  "newPassword": "NewPassword123"
}

# ============ REPOSITORIES ENDPOINTS ============

### Explore public repositories (search & pagination)
GET {{backend_HostAddress}}/api/repositories/explore?search=nginx&page=1&pageSize=20
Accept: application/json

### Create a repository (demo user)
# @name create_repo_demo
POST {{backend_HostAddress}}/api/repositories
Content-Type: application/json
Authorization: Bearer {{demo_login.response.body.token}}

{
  "name": "my-nginx-app",
  "description": "Custom nginx configuration",
  "visibility": "public"
}

### Create a private repository (demo user)
# @name create_private_repo
POST {{backend_HostAddress}}/api/repositories
Content-Type: application/json
Authorization: Bearer {{demo_login.response.body.token}}

{
  "name": "private-project",
  "description": "Private project repository",
  "visibility": "private"
}

### Get my repositories (demo user)
GET {{backend_HostAddress}}/api/repositories/my?page=1&pageSize=20
Authorization: Bearer {{demo_login.response.body.token}}
Accept: application/json

### Get repository details
GET {{backend_HostAddress}}/api/repositories/1
Accept: application/json

### Update repository settings (change description and visibility)
PUT {{backend_HostAddress}}/api/repositories/1
Content-Type: application/json
Authorization: Bearer {{demo_login.response.body.token}}

{
  "description": "Updated nginx app configuration",
  "visibility": "private"
}

### Get all tags for a repository
GET {{backend_HostAddress}}/api/repositories/1/tags
Accept: application/json

### Add a tag to repository
# @name add_tag
POST {{backend_HostAddress}}/api/repositories/1/tags
Content-Type: application/json
Authorization: Bearer {{demo_login.response.body.token}}

{
  "name": "latest"
}

### Add another tag
POST {{backend_HostAddress}}/api/repositories/1/tags
Content-Type: application/json
Authorization: Bearer {{demo_login.response.body.token}}

{
  "name": "v1.0.0"
}

### Delete a tag from repository
DELETE {{backend_HostAddress}}/api/repositories/1/tags/1
Authorization: Bearer {{demo_login.response.body.token}}

### Star a repository (admin stars demo's repo)
# @name star_repo
POST {{backend_HostAddress}}/api/repositories/1/star
Authorization: Bearer {{admin_login.response.body.token}}
Content-Type: application/json

### Unstar a repository
DELETE {{backend_HostAddress}}/api/repositories/1/star
Authorization: Bearer {{admin_login.response.body.token}}
Content-Type: application/json

### Get user's starred repositories
GET {{backend_HostAddress}}/api/repositories/starred/my?page=1&pageSize=20
Authorization: Bearer {{admin_login.response.body.token}}
Accept: application/json

### Registry catalog (self-hosted Distribution)
GET {{backend_HostAddress}}/api/repositories/registry/catalog
Authorization: Bearer {{admin_login.response.body.token}}
Accept: application/json

### Registry tags for repo
GET {{backend_HostAddress}}/api/repositories/registry/tags/library/nginx
Authorization: Bearer {{admin_login.response.body.token}}
Accept: application/json

### Registry manifest by tag
GET {{backend_HostAddress}}/api/repositories/registry/manifests/library/nginx?reference=latest
Authorization: Bearer {{admin_login.response.body.token}}
Accept: application/json

### Delete a repository
DELETE {{backend_HostAddress}}/api/repositories/1
Authorization: Bearer {{demo_login.response.body.token}}

# ============ OLD ENDPOINTS (kept for reference) ============

GET {{backend_HostAddress}}/weatherforecast/
Accept: application/json

###
