# Copy this file to `.env` and fill in real values before running `python run_env.py start`.
#   cp .env.example .env

# -- DATABASE --
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=dockerhub_mimic
POSTGRES_USER=dockerhub_mimic
POSTGRES_PASSWORD=change-me

# -- BACKEND --
BACKEND_HOST=backend
BACKEND_PORT=8080

# -- FRONTEND --
FRONTEND_HOST=frontend
FRONTEND_PORT=3000

# -- REGISTRY --
# The registry container's own port and the JWT settings it uses to trust tokens
# issued by the backend. See deploy/README.md for how the key pair is generated.
REGISTRY_PORT=5000
REGISTRY_JWT_ISSUER=dockerhub-mimic-backend
REGISTRY_JWT_KEY_ID=registry-key-1
REGISTRY_JWT_PRIVATE_KEY_PATH=/app/registry-private.pem
REGISTRY_JWT_PUBLIC_CERT_PATH=/app/registry-public.crt

# -- JWT (application login tokens) --
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-characters
JWT_ISSUER=dockerhub-mimic
JWT_AUDIENCE=dockerhub-mimic-clients

# -- HTTP --
# Host port the reverse proxy (nginx) listens on. The app is reachable at
# http://localhost:<HTTP_PORT> once the stack is up.
HTTP_PORT=3000

# -- EMAIL (organization invites) --
# A local dev SMTP catcher (e.g. Mailhog/Mailpit) works fine here; real credentials
# are only needed if you want invite emails to actually be delivered.
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=25
EMAIL_FROM_ADDRESS=no-reply@dockerhubmimic.local
EMAIL_FROM_NAME=DockerHub Mimic
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_SSL=false

# -- APP --
# Base URL used to build absolute links (invite emails, uploaded avatar URLs, etc).
# Should match http://localhost:<HTTP_PORT> for local use.
APP_BASE_URL=http://localhost:3000

# -- ELASTICSEARCH --
ELASTICSEARCH_URL=http://elasticsearch:9200
